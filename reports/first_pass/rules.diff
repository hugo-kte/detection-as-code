diff -ruN a/credential_access/registry_hive_dump.yml b/credential_access/registry_hive_dump.yml
--- a/credential_access/registry_hive_dump.yml	2026-10-13 13:03:09
+++ b/credential_access/registry_hive_dump.yml	2026-10-13 13:03:10
@@ -19,21 +19,26 @@
     category: process_creation
     product: windows
 detection:
-    reg_save:
+    reg_image:
         Image|endswith: '\reg.exe'
+    reg_verb:
         CommandLine|contains:
-            - 'save'
-            - 'export'
+            - ' save '
+            - ' export '
+    reg_secret_hives:  # every key under SAM and SECURITY is credential material
         CommandLine|contains:
-            - '\sam'
-            - '\security'
-            - '\system'
+            - 'hklm\sam'
+            - 'hklm\security'
+            - 'hkey_local_machine\sam'
+            - 'hkey_local_machine\security'
+    reg_system_hive:  # SYSTEM is mostly configuration: only the whole hive (boot key) counts
+        CommandLine|re|i: '(hklm|hkey_local_machine)\\system("|\s|$)'
     esentutl_copy:
         Image|endswith: '\esentutl.exe'
         CommandLine|contains|all:
             - '/y'
             - 'sam'
-    condition: reg_save or esentutl_copy
+    condition: (reg_image and reg_verb and (reg_secret_hives or reg_system_hive)) or esentutl_copy
 falsepositives:
     - Backup or migration tooling that exports registry hives; correlate with the account and host.
 level: high
